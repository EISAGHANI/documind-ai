{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jobs": {
    "Mode": "All",
    "Concurrency": 2,
    "PollIntervalSeconds": 2,
    "VisibilityTimeoutMinutes": 15,
    "MaxAttempts": 5,
    "RetentionDays": 7
  },
  "Storage": {
    "Provider": "Local",
    "RootPath": "uploads",
    "S3": { "Bucket": "", "Region": "", "ServiceUrl": "", "ForcePathStyle": false },
    "AzureBlob": { "Container": "documents", "ConnectionString": "", "AccountUrl": "" }
  },
  "Redis": {
    "ConnectionString": ""
  },
  "Voyage": {
    "Model": "voyage-4",
    "BatchSize": 128
  },
  "Anthropic": {
    "Model": "claude-opus-5-5",
    "Effort": "medium",
    "RetrievalLimit": 8
  },
  "AiProviders": {
    "OpenAIBaseUrl": "https://api.openai.com/v1/",
    "GeminiBaseUrl": "https://generativelanguage.googleapis.com/v1beta/openai/"
  },
  "DataProtection": {
    "KeysPath": ""
  }
}
