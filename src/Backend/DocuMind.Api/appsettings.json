{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jobs": {
    "Mode": "All",
    "Concurrency": 2,
    "PollIntervalSeconds": 2,
    "VisibilityTimeoutMinutes": 15,
    "MaxAttempts": 5,
    "RetentionDays": 7
  },
  "Storage": {
    "Provider": "Local",
    "RootPath": "uploads",
    "S3": { "Bucket": "", "Region": "", "ServiceUrl": "", "ForcePathStyle": false },
    "AzureBlob": { "Container": "documents", "ConnectionString": "", "AccountUrl": "" }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  },
  "Redis": {
    "ConnectionString": ""
  },
  "AiLimits": {
    "MaxConcurrentCalls": 16,
    "MaxConcurrentCallsPerTenant": 3,
    "QueueTimeoutSeconds": 15,
    "FirstTokenTimeoutSeconds": 60,
    "StreamIdleTimeoutSeconds": 45,
    "StructuredCallTimeoutSeconds": 300,
    "BreakerFailureThreshold": 5,
    "BreakerBreakSeconds": 30
  },
  "RateLimiting": {
    "Enabled": true,
    "UserPerMinute": 120,
    "TenantPerMinute": 600,
    "ExpensivePerMinute": 30,
    "AnonymousPerMinute": 20
  },
  "Quotas": {
    "MaxDocumentsPerTenant": 500,
    "MaxUploadsPerTenantPerDay": 200
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Voyage": {
    "Model": "voyage-4",
    "BatchSize": 128
  },
  "Anthropic": {
    "Model": "claude-opus-5-5",
    "Effort": "medium",
    "RetrievalLimit": 8
  },
  "AiProviders": {
    "OpenAIBaseUrl": "https://api.openai.com/v1/",
    "GeminiBaseUrl": "https://generativelanguage.googleapis.com/v1beta/openai/"
  },
  "DataProtection": {
    "KeysPath": ""
  },
  "RowLevelSecurity": {
    "Enabled": false
  }
}
